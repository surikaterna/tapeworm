{
  "name": "tapeworm",
  "version": "0.4.0",
  "description": "",
  "main": "lib/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "swc src --out-dir lib",
    "build.watch": "swc src --out-dir lib --watch",
    "test": "jest",
    "test.watch": "jest --watch",
    "coverage": "jest --collectCoverage",
    "coverage-start": "jest --collectCoverage && start coverage/lcov-report/index.html",
    "lint": "eslint --env node --env mocha src test",
    "lint.ci": "eslint --env node --env mocha -f checkstyle src test > checkstyle-result.xml || echo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/tapeworm"
  },
  "keywords": [
    "event sourcing",
    "event",
    "store"
  ],
  "prettier": "prettier-config-surikaterna",
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@swc/cli": "^0.1.57",
    "@swc/core": "^1.2.162",
    "@swc/jest": "^0.2.20",
    "babel-eslint": "^10.1.0",
    "chokidar": "^3.5.3",
    "eslint": "^8.12.0",
    "eslint-config-surikat": "^2.0.1",
    "eslint-plugin-import": "^2.25.4",
    "jest": "^27.5.1",
    "prettier": "^2.6.1",
    "prettier-config-surikaterna": "^1.0.1"
  },
  "dependencies": {
    "bluebird": "^2.5.2",
    "lodash": "^2.4.2",
    "uuid": "^8.3.2"
  }
